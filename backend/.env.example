# Copy this file to .env (or export these as real environment variables)
# and NEVER commit the real values.
#
# Get these from Supabase: Project Settings -> Database -> Connection string (JDBC)
SUPABASE_DB_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-db-password>

# Optional overrides
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
PORT=8080
